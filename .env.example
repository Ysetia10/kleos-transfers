# Copy this file to .env for local-only configuration.
# Never commit secrets, tokens, production credentials, or private data.

# PostgreSQL connection settings.
DATABASE_URL=jdbc:postgresql://localhost:5432/kleos_transfers
DATABASE_USERNAME=kleos
DATABASE_PASSWORD=

# Optional HTTP port override.
SERVER_PORT=8080

# Comma-separated browser origins allowed to call the API (production: your Vercel URL).
# Local dev defaults in application.yml if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
